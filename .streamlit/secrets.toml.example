# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is already gitignored -- never commit real
# keys. On Streamlit Cloud, these same keys go in the app's
# Settings -> Secrets manager instead of a file.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "your-anon-or-publishable-key"   # anon/publishable, NEVER service_role

# From the Turnstile widget you create in the Cloudflare dashboard.
# The matching SECRET key goes into Supabase's Authentication ->
# Settings -> CAPTCHA protection, not here.
TURNSTILE_SITE_KEY = "your-turnstile-site-key"

# Already used by generate_explanation.py -- unrelated to this item,
# listed here only if you don't already have it set.
# GROQ_API_KEY = "..."